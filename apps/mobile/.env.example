# Copy this file to .env.local when testing on a physical phone with Expo Go.
#
# Find your computer's Wi-Fi IPv4 address:
#   Windows: ipconfig
#   macOS/Linux: ifconfig | grep "inet "
#
# The phone must be on the same Wi-Fi network as the computer.
# Example: http://192.168.1.3:4000
EXPO_PUBLIC_API_URL=http://192.168.1.100:4000
