{
  "expo": {
    "name": "NutriByte Philippines",
    "slug": "nutribyte-ph",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nutribyte",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#15803d",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.nutribyte.app"
    },
    "android": {
      "package": "ph.nutribyte.app",
      "adaptiveIcon": {
        "backgroundColor": "#15803d"
      }
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
