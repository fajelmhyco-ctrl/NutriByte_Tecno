{
  "expo": {
    "name": "NutriByte Philippines",
    "slug": "nutribyte-ph",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nutribyte",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ph.nutribyte.app"
    },
    "android": {
      "package": "ph.nutribyte.app",
      "adaptiveIcon": {
        "backgroundColor": "#15803d"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      ["expo-splash-screen", { "backgroundColor": "#15803d", "resizeMode": "contain" }]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
