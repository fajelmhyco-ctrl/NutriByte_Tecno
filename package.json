{
  "name": "nutribyte-philippines",
  "private": true,
  "version": "1.0.0",
  "description": "Tele-nutrition marketplace and localized mHealth platform for Filipino cuisine",
  "workspaces": [
    "apps/api",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @nutribyte/api",
    "dev:web": "npm run dev -w @nutribyte/web",
    "dev:mobile": "npm run start -w @nutribyte/mobile",
    "test": "npm run test -w @nutribyte/api",
    "typecheck": "npm run typecheck -w @nutribyte/api && npm run typecheck -w @nutribyte/web"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "expo-font": "57.0.4",
    "expo-router": "57.0.28",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3"
  }
}
